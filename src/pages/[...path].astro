---
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/HomePage.astro";
import ArticlePage from "../components/ArticlePage.astro";
import SectionPage from "../components/SectionPage.astro";
import {
  type Locale,
  activeLocales,
  useTranslations,
  localizedPath,
} from "../i18n/utils";
import {
  getArticlesByLocale,
  getTranslationSlugs,
  type Article,
} from "../lib/content";
import {
  SECTIONS,
  sectionText,
  type SectionId,
} from "../lib/sections";
import { getHeroImage } from "../lib/heroImages";
import { SITE_BRAND } from "../config/site.mjs";
import {
  graph,
  websiteSchema,
  organizationSchema,
  landmarkSchema,
  articleSchema,
  breadcrumbSchema,
  faqSchema,
} from "../lib/schema";

/**
 * `entry.data.hero` es solo la clave del registro de heroImages.ts (p. ej.
 * "sol-hero.jpg"), no una URL pública: astro:assets sirve las imágenes con
 * un nombre final distinto (hash + extensión optimizada) bajo /_astro/. Hay
 * que generar explícitamente una versión 1200x630 para Open Graph/Twitter,
 * si no el og:image de cada página apunta a una URL inexistente.
 */
async function ogImageUrl(heroKey?: string): Promise<string | undefined> {
  const source = getHeroImage(heroKey);
  if (!source) return undefined;
  const optimized = await getImage({
    src: source,
    width: 1200,
    height: 630,
    format: "jpg",
  });
  return optimized.src;
}

export const getStaticPaths = (async () => {
  const paths: Array<{
    params: { path: string };
    props:
      | { kind: "home"; locale: Locale; alternates: Record<string, string> }
      | {
          kind: "section";
          locale: Locale;
          sectionId: SectionId;
          alternates: Record<string, string>;
        }
      | {
          kind: "article";
          locale: Locale;
          entry: Article;
          alternates: Record<string, string>;
        };
  }> = [];

  // Home de cada idioma activo (todos con prefijo: /es/, /en/...)
  const homeAlternates: Record<string, string> = {};
  for (const loc of activeLocales) homeAlternates[loc] = localizedPath(loc);

  for (const loc of activeLocales) {
    paths.push({
      params: { path: loc },
      props: { kind: "home", locale: loc, alternates: { ...homeAlternates } },
    });
  }

  // Páginas de sección (mismo slug en todos los idiomas activos)
  for (const section of SECTIONS) {
    const sectionAlternates: Record<string, string> = {};
    for (const loc of activeLocales) {
      sectionAlternates[loc] = localizedPath(loc, section.slug);
    }
    for (const loc of activeLocales) {
      paths.push({
        params: { path: `${loc}/${section.slug}` },
        props: {
          kind: "section",
          locale: loc,
          sectionId: section.id,
          alternates: { ...sectionAlternates },
        },
      });
    }
  }

  // Artículos de cada idioma activo
  for (const loc of activeLocales) {
    const entries = await getArticlesByLocale(loc);
    for (const entry of entries) {
      const slugMap = await getTranslationSlugs(entry.data.translationKey);
      const alternates: Record<string, string> = {};
      for (const [l, s] of Object.entries(slugMap)) {
        if (s && (activeLocales as string[]).includes(l)) {
          alternates[l] = localizedPath(l as Locale, s);
        }
      }
      paths.push({
        params: { path: `${loc}/${entry.data.slug}` },
        props: { kind: "article", locale: loc, entry, alternates },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const props = Astro.props;
const { locale, alternates } = props;
const t = useTranslations(locale);

let title: string;
let description: string;
let type: "website" | "article" = "website";
let jsonLd: unknown;
let ogImage: string | undefined;
let ogImageAlt: string | undefined;

if (props.kind === "home") {
  title = `${SITE_BRAND} · ${t("site.tagline")}`;
  description = t("site.tagline");
  jsonLd = graph([websiteSchema(), organizationSchema(), landmarkSchema()]);
  ogImage = await ogImageUrl("sol-hero-portada.jpg");
  ogImageAlt = t("home.hero.alt");
} else if (props.kind === "section") {
  const section = SECTIONS.find((s) => s.id === props.sectionId)!;
  const st = sectionText(section, locale);
  title = `${st.title} · ${SITE_BRAND}`;
  description = st.description;
  const url = localizedPath(locale, section.slug);
  jsonLd = graph([
    organizationSchema(),
    breadcrumbSchema([
      { name: t("breadcrumb.home"), url: localizedPath(locale) },
      { name: st.title, url },
    ]),
    landmarkSchema(),
  ]);
  ogImage = await ogImageUrl(section.hero);
  ogImageAlt = st.title;
} else {
  const { entry } = props;
  // metaTitle/metaDescription son overrides solo para SEO (<title>, meta
  // description, og/twitter): el H1 y el párrafo visibles siempre usan
  // entry.data.title/description sin recortar.
  title = entry.data.metaTitle ?? entry.data.title;
  description = entry.data.metaDescription ?? entry.data.description;
  type = "article";

  const url = localizedPath(locale, entry.data.slug);
  const articleSection = entry.data.section
    ? SECTIONS.find((s) => s.id === entry.data.section)
    : undefined;
  ogImage = await ogImageUrl(entry.data.hero);
  ogImageAlt = entry.data.heroAlt ?? entry.data.title;
  const nodes: unknown[] = [
    organizationSchema(),
    articleSchema({
      title: entry.data.title,
      description: entry.data.description,
      url,
      updated: entry.data.updated,
      locale,
      image: ogImage,
      sources: entry.data.sources,
    }),
    breadcrumbSchema([
      { name: t("breadcrumb.home"), url: localizedPath(locale) },
      ...(articleSection
        ? [
            {
              name: sectionText(articleSection, locale).label,
              url: localizedPath(locale, articleSection.slug),
            },
          ]
        : []),
      { name: entry.data.title, url },
    ]),
    faqSchema(entry.data.faq),
    landmarkSchema(),
  ];
  jsonLd = graph(nodes);
}
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternates={alternates}
  type={type}
  image={ogImage}
  imageAlt={ogImageAlt}
  jsonLd={jsonLd}
>
  {props.kind === "home" ? (
    <HomePage locale={locale} />
  ) : props.kind === "section" ? (
    <SectionPage locale={locale} sectionId={props.sectionId} />
  ) : (
    <ArticlePage entry={props.entry} locale={locale} />
  )}
</BaseLayout>
