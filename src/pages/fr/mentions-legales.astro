---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalPage from "../../components/LegalPage.astro";
import { localizedPath } from "../../i18n/utils";

const alternates = {
  es: localizedPath("es", "aviso-legal"),
  en: localizedPath("en", "legal-notice"),
  fr: localizedPath("fr", "mentions-legales"),
};
---

<BaseLayout
  title="Mentions légales"
  description="Informations d’identification du titulaire de PuertaDelSol.com et conditions d’accès et d’utilisation du site web, conformément à la LSSI-CE."
  locale="fr"
  alternates={alternates}
>
  <LegalPage locale="fr" title="Mentions légales" updated="Dernière mise à jour : août 2026">
    <h2>1. Informations d’identification</h2>
    <p>
      Conformément à l’article 10 de la loi espagnole 34/2002 du 11 juillet
      relative aux services de la société de l’information et au commerce
      électronique (LSSI-CE), les informations d’identification du titulaire
      de ce site web sont communiquées ci-dessous :
    </p>
    <ul>
      <li><strong>Dénomination sociale :</strong> Plus Ultra Properties SL</li>
      <li><strong>CIF :</strong> B86125986</li>
      <li><strong>Siège social :</strong> Puerta del Sol, 11, 28013 Madrid, Espagne</li>
      <li><strong>Téléphone :</strong> +34 919 891 469</li>
      <li>
        <strong>Adresse électronique :</strong>{" "}
        <a href="mailto:recepcion@lafondadelosprincipes.com">
          recepcion@lafondadelosprincipes.com
        </a>
      </li>
      <li><strong>Site web :</strong> www.puertadelsol.com</li>
