---
import { type Locale, useTranslations, localizedPath } from "../i18n/utils";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  locale: Locale;
  title: string;
  updated: string;
}

const { locale, title, updated } = Astro.props;
const t = useTranslations(locale);

const crumbs = [
  { name: t("breadcrumb.home"), href: localizedPath(locale) },
  { name: title, href: "" },
];
---

<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  <Breadcrumbs items={crumbs} />
  <header class="mt-6 max-w-3xl">
    <h1 class="text-balance text-4xl sm:text-5xl">{title}</h1>
    <p class="mt-3 font-sans text-xs uppercase tracking-wide text-muted">{updated}</p>
  </header>
  <div class="prose-sol mt-8 max-w-none">
    <slot />
  </div>
</article>
