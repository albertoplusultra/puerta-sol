---
import { Image } from "astro:assets";
import { getExperiences } from "../data/experiences";
import { civitatisUrl } from "../config/site.mjs";
import type { Locale } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const experiences = getExperiences(locale);

const labels = {
  es: {
    starts: "Sale de Sol",
    book: "Reservar en Civitatis",
    notice:
      "Las reservas se gestionan en Civitatis, plataforma independiente de actividades. Los horarios y precios pueden variar; consulta cada actividad para ver la información actualizada y el punto exacto de encuentro.",
  },
  en: {
    starts: "Starts at Sol",
    book: "Book on Civitatis",
    notice:
      "Bookings are handled by Civitatis, an independent activities platform. Times and prices may vary; check each activity for up-to-date information and the exact meeting point.",
  },
  fr: {
    starts: "Départ de Sol",
    book: "Réserver sur Civitatis",
    notice:
      "Les réservations sont gérées par Civitatis, une plateforme d’activités indépendante. Les horaires et les prix peuvent varier ; consultez chaque activité pour connaître les informations à jour et le lieu de rendez-vous exact.",
  },
} as const;

const text = labels[locale === "en" || locale === "fr" ? locale : "es"];
---

<div class="not-prose mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2">
  {
    experiences.map((exp) => (
      <a
        href={civitatisUrl(exp.path)}
        target="_blank"
        rel="nofollow noopener"
        class="group flex flex-col"
      >
        <div class="relative overflow-hidden bg-ink-900 aspect-[16/9]">
          <Image
            src={exp.image}
            alt={exp.title}
            widths={[400, 640]}
            sizes="(min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            format="avif"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
          />
          {exp.startsAtSol && (
            <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 bg-ink-900/85 px-2.5 py-1 font-sans text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-ivory-50">
              <span aria-hidden="true">&#9679;</span>
              {text.starts}
            </span>
          )}
        </div>
        <h3 class="mt-4 font-display text-2xl leading-tight transition-colors group-hover:text-brand">
          {exp.title}
        </h3>
        <p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-muted">
          {exp.description}
        </p>
        {exp.meta && (
          <p class="mt-3 font-sans text-xs uppercase tracking-[0.12em] text-muted/80">
            {exp.meta}
          </p>
        )}
        <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-brand">
          {text.book}
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            &#8599;
          </span>
        </span>
      </a>
    ))
  }
</div>
<p class="mt-8 font-serif text-sm leading-relaxed text-muted">
  {text.notice}
</p>
