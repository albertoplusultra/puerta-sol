---
import { render } from "astro:content";
import { type Locale, useTranslations, localizedPath } from "../i18n/utils";
import { type Article, getRelated } from "../lib/content";
import { getSection, sectionText } from "../lib/sections";
import { getHeroImage } from "../lib/heroImages";
import { IMAGE_CREDITS } from "../config/credits.mjs";
import { SITE_NAME } from "../config/site.mjs";
import Hero from "./Hero.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import Faq from "./Faq.astro";
import Card from "./Card.astro";
import MapEmbed from "./MapEmbed.astro";

interface Props {
  entry: Article;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);

const { Content } = await render(entry);
const related = await getRelated(entry);

const section = entry.data.section ? getSection(entry.data.section) : undefined;

const crumbs = [
  { name: t("breadcrumb.home"), href: localizedPath(locale) },
  ...(section
    ? [
        {
          name: sectionText(section, locale).label,
          href: localizedPath(locale, section.slug),
        },
      ]
    : []),
  { name: entry.data.title, href: localizedPath(locale, entry.data.slug) },
];

const showMap = entry.data.category === "practical" || entry.data.translationKey === "plan";

const heroImage = getHeroImage(entry.data.hero);
const heroCredit = entry.data.hero
  ? IMAGE_CREDITS[entry.data.hero as keyof typeof IMAGE_CREDITS]
  : undefined;
---

{
  heroImage ? (
    <Hero
      size="compact"
      kicker={`${SITE_NAME} · Madrid`}
      title={entry.data.title}
      subtitle={entry.data.description}
      image={heroImage}
      imageAlt={entry.data.heroAlt ?? entry.data.title}
      credit={heroCredit}
    />
  ) : null
}

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
  <Breadcrumbs items={crumbs} />

  {
    !heroImage && (
      <header class="mt-6 max-w-3xl">
        <h1 class="text-balance text-4xl sm:text-5xl">{entry.data.title}</h1>
        <p class="mt-4 font-serif text-lg text-muted">{entry.data.description}</p>
      </header>
    )
  }

  <div class="mt-8">
    <div class="prose-sol dropcap max-w-none">
      <Content />

      {showMap && <MapEmbed />}

      <Faq title={t("faq.title")} items={entry.data.faq} />
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="mt-16 border-t border-base pt-10">
        <h2 class="mb-8 font-display text-3xl">{t("related.title")}</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => (
            <Card
              href={localizedPath(locale, r.data.slug)}
              title={r.data.title}
              description={r.data.description}
            />
          ))}
        </div>
      </section>
    )
  }
</article>
