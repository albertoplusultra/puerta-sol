---
import { render } from "astro:content";
import { type Locale, useTranslations, localizedPath } from "../i18n/utils";
import { type Article, getRelated } from "../lib/content";
import Breadcrumbs from "./Breadcrumbs.astro";
import Toc from "./Toc.astro";
import Faq from "./Faq.astro";
import RecommendationCard from "./RecommendationCard.astro";
import Card from "./Card.astro";
import MapEmbed from "./MapEmbed.astro";

interface Props {
  entry: Article;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);

const { Content, headings } = await render(entry);
const related = await getRelated(entry);

// Tiempo de lectura estimado (~200 palabras/min)
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

const updated = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.updated);

const crumbs = [
  { name: t("breadcrumb.home"), href: localizedPath(locale) },
  { name: entry.data.title, href: localizedPath(locale, entry.data.slug) },
];

const showLodging = entry.data.promote === "lodging" || entry.data.promote === "both";
const showRestaurant = entry.data.promote === "restaurant" || entry.data.promote === "both";
const showMap = entry.data.category === "practical" || entry.data.translationKey === "plan";
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
  <Breadcrumbs items={crumbs} />

  <header class="mt-6 max-w-3xl">
    <h1 class="text-balance text-4xl font-semibold sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 text-lg text-muted">{entry.data.description}</p>
    <p class="mt-4 text-sm text-muted">
      {t("article.updated")} <time datetime={entry.data.updated.toISOString()}>{updated}</time>
      <span class="mx-2" aria-hidden="true">·</span>
      {readingTime} {t("article.readingTime")}
    </p>
  </header>

  <div class="mt-10 gap-10 lg:grid lg:grid-cols-[1fr_16rem]">
    <div class="prose-sol max-w-3xl">
      <Content />

      {showMap && <MapEmbed />}
      {showLodging && <RecommendationCard kind="lodging" locale={locale} />}
      {showRestaurant && <RecommendationCard kind="restaurant" locale={locale} />}

      <Faq title={t("faq.title")} items={entry.data.faq} />
    </div>

    <aside class="mt-10 lg:mt-0">
      <div class="lg:sticky lg:top-24">
        <Toc title={t("toc.title")} headings={headings} />
      </div>
    </aside>
  </div>

  {
    related.length > 0 && (
      <section class="mt-16 border-t border-base pt-10">
        <h2 class="mb-6 text-2xl font-semibold">{t("related.title")}</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => (
            <Card
              href={localizedPath(locale, r.data.slug)}
              title={r.data.title}
              description={r.data.description}
            />
          ))}
        </div>
      </section>
    )
  }
</article>
