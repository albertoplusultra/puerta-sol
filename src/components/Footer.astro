---
import {
  type Locale,
  useTranslations,
  localizedPath,
  activeLocales,
  labelFor,
} from "../i18n/utils";
import { getNav } from "../lib/nav";
import { SITE_NAME } from "../config/site.mjs";

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const nav = await getNav(locale);
const year = new Date().getFullYear();

// Las páginas legales solo existen en es/en; el resto de idiomas activos
// (cuando los haya) caerán al español como fallback razonable.
const legalSlug: Partial<Record<Locale, string>> = {
  es: "aviso-legal",
  en: "legal-notice",
};
const privacySlug: Partial<Record<Locale, string>> = {
  es: "privacidad",
  en: "privacy-policy",
};
const legalHref = localizedPath(locale, legalSlug[locale] ?? legalSlug.es!);
const privacyHref = localizedPath(locale, privacySlug[locale] ?? privacySlug.es!);
---

<footer class="mt-20 border-t border-base bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-lg font-semibold">{SITE_NAME}</p>
      <p class="mt-2 max-w-sm text-sm text-muted">{t("footer.about")}</p>
    </div>

    <nav aria-label={t("footer.explore")}>
      <p class="text-sm font-semibold">{t("footer.explore")}</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-body" href={localizedPath(locale)}>{t("nav.home")}</a></li>
        {nav.map((item) => (
          <li><a class="hover:text-body" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    {activeLocales.length > 1 && (
      <nav aria-label={t("footer.langs")}>
        <p class="text-sm font-semibold">{t("footer.langs")}</p>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          {activeLocales.map((loc) => (
            <li>
              <a class="hover:text-body" hreflang={loc} lang={loc} href={alternates[loc] ?? localizedPath(loc)}>
                {labelFor(loc)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <div class="border-t border-base">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs text-muted sm:px-6">
      <p>&copy; {year} {SITE_NAME}. {t("footer.rights")}</p>
      <nav aria-label="Legal" class="flex items-center gap-4">
        <a class="hover:text-body" href={legalHref}>{t("footer.legal")}</a>
        <a class="hover:text-body" href={privacyHref}>{t("footer.privacy")}</a>
      </nav>
    </div>
  </div>
</footer>
