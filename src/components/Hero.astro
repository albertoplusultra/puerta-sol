---
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
}

const { kicker, title, subtitle, ctaPrimary, ctaSecondary } = Astro.props;
---

<section class="relative overflow-hidden border-b border-base bg-page">
  <!-- Fondo decorativo evocando el sol -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-sol-300/40 blur-3xl"></div>
    <div class="absolute -left-32 top-20 h-80 w-80 rounded-full bg-terracota-200/40 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
    {kicker && (
      <p class="mb-4 inline-block rounded-full bg-sol-100 px-3 py-1 text-sm font-semibold uppercase tracking-wide text-sol-800">
        {kicker}
      </p>
    )}
    <h1 class="text-balance text-4xl font-semibold sm:text-6xl">{title}</h1>
    {subtitle && (
      <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg text-muted sm:text-xl">
        {subtitle}
      </p>
    )}
    {(ctaPrimary || ctaSecondary) && (
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {ctaPrimary && (
          <a
            href={ctaPrimary.href}
            class="rounded-lg bg-brand px-5 py-3 font-semibold text-on-brand shadow-[var(--shadow-soft)] transition-transform hover:-translate-y-0.5"
          >
            {ctaPrimary.label}
          </a>
        )}
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="rounded-lg border border-base bg-elevated px-5 py-3 font-semibold text-body transition-colors hover:bg-surface"
          >
            {ctaSecondary.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
