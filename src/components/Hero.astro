---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Cta {
  label: string;
  href: string;
}

interface Credit {
  author: string;
  license: string;
  licenseUrl: string;
  source: string;
}

interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  credit?: Credit;
  ctaPrimary?: Cta;
  ctaSecondary?: Cta;
  size?: "full" | "compact";
}

const {
  kicker,
  title,
  subtitle,
  image,
  imageAlt = "",
  ctaPrimary,
  ctaSecondary,
  size = "full",
} = Astro.props;

const minH = size === "full" ? "min-h-[78vh]" : "min-h-[52vh]";
---

<section class:list={["relative isolate flex items-end overflow-hidden", minH]}>
  {
    image ? (
      <>
        <Image
          src={image}
          alt={imageAlt}
          widths={[768, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          format="avif"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900/85 via-ink-900/40 to-ink-900/20"></div>
      </>
    ) : (
      <div class="absolute inset-0 -z-10 bg-surface"></div>
    )
  }

  <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-36">
    <div class="max-w-3xl text-ivory-50">
      {kicker && (
        <p class="mb-4 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-ivory-100/90">
          {kicker}
        </p>
      )}
      <h1 class="font-logo text-5xl leading-[1.02] tracking-tight sm:text-7xl">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-ivory-100/90 sm:text-xl">
          {subtitle}
        </p>
      )}
      {(ctaPrimary || ctaSecondary) && (
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {ctaPrimary && (
            <a
              href={ctaPrimary.href}
              class="rounded-md bg-brand px-6 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-on-brand transition-transform hover:-translate-y-0.5"
            >
              {ctaPrimary.label}
            </a>
          )}
          {ctaSecondary && (
            <a
              href={ctaSecondary.href}
              class="rounded-md border border-ivory-100/40 px-6 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-ivory-50 transition-colors hover:bg-ivory-50/10"
            >
              {ctaSecondary.label}
            </a>
          )}
        </div>
      )}
    </div>
  </div>

</section>
