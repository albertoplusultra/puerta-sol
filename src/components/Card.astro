---
interface Props {
  href: string;
  title: string;
  description?: string;
  kicker?: string;
}

const { href, title, description, kicker } = Astro.props;
---

<a href={href} class="group flex flex-col border-t border-ink-900/15 pt-5">
  {kicker && <span class="kicker">{kicker}</span>}
  <h3 class="mt-2 font-display text-2xl leading-tight transition-colors group-hover:text-brand">
    {title}
  </h3>
  {description && (
    <p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-muted">{description}</p>
  )}
  <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-brand">
    Leer
    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
  </span>
</a>
