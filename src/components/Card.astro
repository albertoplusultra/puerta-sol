---
interface Props {
  href: string;
  title: string;
  description?: string;
  kicker?: string;
}

const { href, title, description, kicker } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-xl border border-base bg-elevated p-5 shadow-[var(--shadow-soft)] transition-all hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)]"
>
  {kicker && (
    <span class="mb-2 text-xs font-semibold uppercase tracking-wide text-accent">
      {kicker}
    </span>
  )}
  <h3 class="text-lg font-semibold group-hover:text-brand">{title}</h3>
  {description && <p class="mt-2 text-sm text-muted">{description}</p>}
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-link">
    <span aria-hidden="true">&rarr;</span>
  </span>
</a>
