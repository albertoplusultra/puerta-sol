---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Aceptado por compatibilidad; ya no se muestra atribución. */
  creditKey?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={["not-prose my-10", wide && "lg:-mx-24"]}>
  <div class="overflow-hidden rounded-lg border border-base">
    <Image
      src={src}
      alt={alt}
      widths={[600, 1000, 1600]}
      sizes={wide ? "(min-width: 1024px) 900px, 100vw" : "(min-width: 768px) 720px, 100vw"}
      loading="lazy"
      decoding="async"
      format="avif"
      class="h-auto w-full"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-2 font-sans text-xs text-muted">{caption}</figcaption>
    )
  }
</figure>
