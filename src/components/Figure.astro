---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { IMAGE_CREDITS } from "../config/credits.mjs";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Nombre de archivo (clave en IMAGE_CREDITS) para mostrar la autoría. */
  creditKey?: string;
  wide?: boolean;
}

const { src, alt, caption, creditKey, wide = false } = Astro.props;
const credit = creditKey
  ? IMAGE_CREDITS[creditKey as keyof typeof IMAGE_CREDITS]
  : undefined;
---

<figure class:list={["not-prose my-10", wide && "lg:-mx-24"]}>
  <div class="overflow-hidden rounded-lg border border-base">
    <Image
      src={src}
      alt={alt}
      widths={[600, 1000, 1600]}
      sizes={wide ? "(min-width: 1024px) 900px, 100vw" : "(min-width: 768px) 720px, 100vw"}
      loading="lazy"
      decoding="async"
      format="avif"
      class="h-auto w-full"
    />
  </div>
  {
    (caption || credit) && (
      <figcaption class="mt-2 font-sans text-xs text-muted">
        {caption}
        {credit && (
          <span class="text-ink-400">
            {caption ? " · " : ""}Foto:{" "}
            <a href={credit.source} target="_blank" rel="noopener" class="underline">
              {credit.author}
            </a>{" "}
            (
            <a href={credit.licenseUrl} target="_blank" rel="noopener" class="underline">
              {credit.license}
            </a>
            )
          </span>
        )}
      </figcaption>
    )
  }
</figure>
