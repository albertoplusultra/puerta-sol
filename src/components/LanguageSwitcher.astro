---
import { activeLocales, labelFor, type Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { HREFLANG } from "../config/site.mjs";

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
// Solo tiene sentido mostrar el selector si hay más de un idioma publicado.
const show = activeLocales.length > 1;
---

{show && (
<div class="lang-switcher">
  <details class="relative">
    <summary
      class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-base px-2.5 py-1.5 text-sm font-medium text-body hover:bg-surface"
      aria-label={t("lang.switch")}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span class="uppercase">{locale}</span>
    </summary>
    <ul
      class="absolute right-0 z-50 mt-1 min-w-40 rounded-lg border border-base bg-elevated py-1 shadow-[var(--shadow-lift)]"
    >
      {
        activeLocales.map((loc) => {
          const href = alternates[loc];
          const current = loc === locale;
          return (
            <li>
              <a
                href={href ?? "/"}
                hreflang={HREFLANG[loc]}
                lang={loc}
                aria-current={current ? "true" : undefined}
                class:list={[
                  "flex items-center justify-between gap-3 px-3 py-1.5 text-sm hover:bg-surface",
                  current ? "font-semibold text-brand" : "text-body",
                ]}
              >
                <span>{labelFor(loc)}</span>
                <span class="text-xs uppercase text-muted">{loc}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </details>
</div>
)}

<style>
  /* Cerrar el desplegable al perder foco (sin JS de framework) */
  details > summary::-webkit-details-marker { display: none; }
</style>

<script>
  // Cierra el selector de idioma al hacer clic fuera.
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".lang-switcher details[open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute("open");
    });
  });
</script>
