---
import { type Locale, useTranslations } from "../i18n/utils";
import { PARTNERS } from "../config/site.mjs";

interface Props {
  kind: "lodging" | "restaurant";
  locale: Locale;
}

const { kind, locale } = Astro.props;
const t = useTranslations(locale);
const partner = PARTNERS[kind];

const copy =
  kind === "lodging"
    ? {
        kicker: t("reco.lodging.kicker"),
        desc: t("reco.lodging.desc"),
        cta: t("reco.lodging.cta"),
      }
    : {
        kicker: t("reco.restaurant.kicker"),
        desc: t("reco.restaurant.desc"),
        cta: t("reco.restaurant.cta"),
      };

const icon =
  kind === "lodging"
    ? "M3 21V10l9-6 9 6v11h-6v-6h-6v6H3z"
    : "M6 3v8a3 3 0 0 0 6 0V3M9 3v18M18 3c-1.7 0-3 2-3 5s1.3 4 3 4v9";
---

<aside class="not-prose my-10 overflow-hidden rounded-lg border border-base bg-elevated shadow-[var(--shadow-soft)]">
  <div class="flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-7">
    <div class="flex items-start gap-4">
      <span
        class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-base text-brand"
        aria-hidden="true"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d={icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <div>
        <p class="kicker">{copy.kicker}</p>
        <p class="mt-1 font-display text-2xl">{partner.name}</p>
        <p class="mt-1.5 max-w-md text-[0.95rem] leading-relaxed text-muted">{copy.desc}</p>
      </div>
    </div>
    <a
      href={partner.url}
      rel="dofollow noopener"
      target="_blank"
      class="shrink-0 rounded-md bg-brand px-5 py-3 text-center text-sm font-semibold uppercase tracking-wide text-on-brand transition-transform hover:-translate-y-0.5"
    >
      {copy.cta}
    </a>
  </div>
</aside>
