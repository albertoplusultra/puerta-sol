---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<aside class="not-prose my-10 border-y border-base py-6 lg:-mx-16">
  <blockquote class="font-display text-2xl leading-snug text-body sm:text-3xl">
    <slot />
  </blockquote>
  {cite && <p class="mt-3 font-sans text-xs uppercase tracking-wide text-muted">{cite}</p>}
</aside>
