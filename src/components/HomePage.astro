---
import { Image } from "astro:assets";
import { type Locale, useTranslations, localizedPath } from "../i18n/utils";
import { getPillar, getArticlesByLocale } from "../lib/content";
import {
  SECTIONS,
  sectionText,
  getSectionArticles,
} from "../lib/sections";
import { getHeroImage } from "../lib/heroImages";
import { IMAGE_CREDITS } from "../config/credits.mjs";
import Hero from "./Hero.astro";
import MediaCard from "./MediaCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pillar = await getPillar(locale);
const all = await getArticlesByLocale(locale);
const byKey = (k: string) => all.find((a) => a.data.translationKey === k);

const historia = byKey("historia");

const heroImg = getHeroImage("sol-hero-portada.jpg");
const heroCredit = IMAGE_CREDITS["sol-hero-portada.jpg"];
const historiaImg = getHeroImage("sol-hero-old.png");

// Una sección de la home por cada sección de navegación.
// Historia se destaca aparte, así que no la repetimos en su rejilla.
const orderedSections = [...SECTIONS].sort((a, b) => a.order - b.order);
const sections = (
  await Promise.all(
    orderedSections.map(async (s) => ({
      title: sectionText(s, locale).title,
      href: localizedPath(locale, s.slug),
      items: (await getSectionArticles(locale, s.id)).filter(
        (a) => a.data.translationKey !== "historia" && !a.data.disappeared
      ),
    }))
  )
).filter((s) => s.items.length > 0);
---

<Hero
  kicker="Madrid · Kilómetro Cero"
  title="Puerta del Sol"
  subtitle={t("site.tagline")}
  image={heroImg}
  imageAlt="Vista panorámica de la Puerta del Sol de Madrid con la Real Casa de Correos"
  credit={heroCredit}
  ctaPrimary={historia
    ? { label: t("nav.history"), href: localizedPath(locale, historia.data.slug) }
    : undefined}
  ctaSecondary={pillar
    ? { label: t("hero.cta.guide"), href: localizedPath(locale, pillar.data.slug) }
    : undefined}
/>

<div class="mx-auto max-w-6xl px-4 sm:px-6">
  {pillar && (
    <p class="mx-auto max-w-3xl border-b border-base py-14 text-center font-serif text-2xl leading-relaxed text-body sm:text-[1.6rem]">
      {pillar.data.description}
    </p>
  )}

  {
    historia && (
      <section class="grid items-center gap-8 py-16 md:grid-cols-2 md:gap-12">
        {historiaImg && (
          <a href={localizedPath(locale, historia.data.slug)} class="block overflow-hidden rounded-lg border border-base">
            <Image
              src={historiaImg}
              alt="La Puerta del Sol iluminada"
              widths={[500, 800, 1200]}
              sizes="(min-width: 768px) 560px, 100vw"
              loading="lazy"
              format="avif"
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </a>
        )}
        <div>
          <p class="kicker">{t("nav.history")}</p>
          <h2 class="mt-3 font-display text-4xl leading-tight sm:text-5xl">
            {historia.data.title}
          </h2>
          <p class="mt-4 font-serif text-lg leading-relaxed text-muted">
            {historia.data.description}
          </p>
          <a
            href={localizedPath(locale, historia.data.slug)}
            class="mt-6 inline-flex items-center gap-1.5 font-sans text-sm font-semibold uppercase tracking-wide text-brand"
          >
            {t("hero.cta.guide")}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </section>
    )
  }

  {
    sections.map((section) => (
      <section class="border-t border-base py-16">
        <div class="mb-10 flex items-end justify-between gap-4">
          <h2 class="font-display text-3xl sm:text-4xl">
            <a href={section.href} class="transition-colors hover:text-brand">
              {section.title}
            </a>
          </h2>
          <a
            href={section.href}
            class="shrink-0 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-brand"
          >
            {t("home.section.all")}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {section.items.map((item) => (
            <MediaCard
              href={localizedPath(locale, item.data.slug)}
              title={item.data.title}
              description={item.data.description}
              image={getHeroImage(item.data.hero)}
              imageAlt={item.data.heroAlt ?? item.data.title}
            />
          ))}
        </div>
      </section>
    ))
  }

</div>
