---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  description?: string;
  kicker?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Relación de aspecto del recuadro superior. */
  ratio?: "landscape" | "portrait";
}

const {
  href,
  title,
  description,
  kicker,
  image,
  imageAlt,
  ratio = "landscape",
} = Astro.props;

const aspect = ratio === "portrait" ? "aspect-[3/4]" : "aspect-[4/3]";
---

<a href={href} class="group flex flex-col">
  <div class:list={["relative overflow-hidden bg-ink-900", aspect]}>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 100vw"
          loading="lazy"
          decoding="async"
          format="avif"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-ink-700 via-ink-900 to-ink-800">
          <div
            class="absolute inset-0 opacity-[0.14]"
            style="background: radial-gradient(120% 120% at 50% 35%, var(--color-sol-400) 0%, transparent 55%);"
          />
          <svg
            class="absolute left-1/2 top-1/2 h-24 w-24 -translate-x-1/2 -translate-y-1/2 text-sol-400/70 transition-transform duration-700 ease-out group-hover:rotate-45"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="3.4" fill="currentColor" />
            <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9" />
            </g>
          </svg>
        </div>
      )
    }
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900/50 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>
  </div>

  {kicker && <span class="kicker mt-4">{kicker}</span>}
  <h3
    class:list={[
      "font-display text-2xl leading-tight transition-colors group-hover:text-brand",
      kicker ? "mt-1.5" : "mt-4",
    ]}
  >
    {title}
  </h3>
  {
    description && (
      <p class="mt-2 font-serif text-[0.95rem] leading-relaxed text-muted">
        {description}
      </p>
    )
  }
  <span class="mt-3 inline-flex items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-brand">
    Leer
    <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
      &rarr;
    </span>
  </span>
</a>
