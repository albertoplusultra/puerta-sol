---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  sizes = "(min-width: 1024px) 800px, 100vw",
  widths = [400, 800, 1200, 1600],
  loading = "lazy",
  class: className,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  sizes={sizes}
  widths={widths}
  loading={loading}
  decoding="async"
  format="avif"
  class={className}
/>
