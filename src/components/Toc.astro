---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  headings: Heading[];
}

const { title, headings } = Astro.props;
// Solo H2 y H3 para una tabla de contenidos limpia
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-label={title} class="rounded-xl border border-base bg-surface p-5 text-sm">
      <p class="mb-3 font-semibold uppercase tracking-wide text-muted">{title}</p>
      <ul class="space-y-2">
        {items.map((h) => (
          <li class:list={[h.depth === 3 && "ml-4"]}>
            <a href={`#${h.slug}`} class="text-muted hover:text-brand hover:underline">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
